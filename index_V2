<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Sân Cỏ Numerator - Quản Lý Quỹ Đội</title>
  
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Sân Cỏ Numerator" />
  <meta name="theme-color" content="#004A52" />

  <link id="app-apple-touch-icon" rel="apple-touch-icon" sizes="180x180" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'%3E%3Crect width='180' height='180' rx='40' fill='%23004A52'/%3E%3Ccircle cx='90' cy='82' r='54' fill='%231AA7B7' stroke='%23FFD61F' stroke-width='5'/%3E%3Ctext x='90' y='99' font-size='56' text-anchor='middle'%3E%E2%9A%BD%3C/text%3E%3Ctext x='90' y='156' font-family='system-ui,-apple-system,sans-serif' font-weight='900' font-size='12' fill='%23FFD61F' text-anchor='middle' letter-spacing='0.5'%3ES%C3%82N C%E1%BB%8E%3C/text%3E%3C/svg%3E" />
  <link id="app-favicon" rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'%3E%3Crect width='180' height='180' rx='40' fill='%23004A52'/%3E%3Ccircle cx='90' cy='82' r='54' fill='%231AA7B7' stroke='%23FFD61F' stroke-width='5'/%3E%3Ctext x='90' y='99' font-size='56' text-anchor='middle'%3E%E2%9A%BD%3C/text%3E%3Ctext x='90' y='156' font-family='system-ui,-apple-system,sans-serif' font-weight='900' font-size='12' fill='%23FFD61F' text-anchor='middle' letter-spacing='0.5'%3ES%C3%82N C%E1%BB%8E%3C/text%3E%3C/svg%3E" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            kantar: {
              sumo: '#004A52',
              blue: '#1AA7B7',
              yellow: '#FFD61F'
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    body { -webkit-tap-highlight-color: transparent; }
    @keyframes pulse-fast { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    .animate-sync { animation: pulse-fast 1s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen pb-16 select-none">

  <!-- Header -->
  <header class="bg-kantar-sumo text-white shadow-md sticky top-0 z-30">
    <div class="max-w-md mx-auto px-4 py-2.5 flex justify-between items-center">
      <div class="flex items-center space-x-2">
        <i class="fa-solid fa-futbol text-2xl text-kantar-yellow"></i>
        <div>
          <div class="flex items-center gap-1.5">
            <h1 class="font-bold text-base leading-tight">Sân Cỏ Numerator</h1>
            <span id="cloud-status-badge" onclick="openCloudModal()" class="cursor-pointer text-[10px] bg-black/20 hover:bg-black/40 border border-white/20 px-1.5 py-0.5 rounded-full flex items-center gap-1 font-medium transition">
              <span id="cloud-status-dot" class="w-2 h-2 rounded-full bg-slate-300"></span>
              <span id="cloud-status-text">Đang tải...</span>
            </span>
          </div>
          <p class="text-xs text-kantar-blue mt-0.5" id="role-indicator">Vai trò: Cầu thủ (Xem & Điểm danh)</p>
        </div>
      </div>
      <button onclick="toggleRoleModal()" class="text-xs bg-black/20 hover:bg-black/40 border border-white/20 px-3 py-1.5 rounded-lg flex items-center space-x-1.5 transition shadow-sm">
        <i class="fa-solid fa-user-shield text-kantar-yellow" id="role-btn-icon"></i>
        <span id="role-btn-text" class="font-medium">Vào quyền Đội trưởng</span>
      </button>
    </div>

    <!-- Thanh chọn 2 trận trong tuần -->
    <div class="max-w-md mx-auto px-4 pb-2.5 pt-1">
      <div class="grid grid-cols-2 gap-2 bg-black/20 p-1 rounded-xl">
        <button id="btn-match-1" onclick="switchMatch(0)" class="py-2 text-xs font-bold rounded-lg bg-white text-kantar-sumo shadow transition flex items-center justify-center space-x-1">
          <i class="fa-regular fa-calendar-check mr-1"></i><span id="label-match-1">Trận 1</span>
        </button>
        <button id="btn-match-2" onclick="switchMatch(1)" class="py-2 text-xs font-semibold rounded-lg text-white hover:bg-black/20 transition flex items-center justify-center space-x-1">
          <i class="fa-regular fa-calendar-check mr-1"></i><span id="label-match-2">Trận 2</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-md mx-auto px-4 pt-3 space-y-3">
    <!-- Banner Đội trưởng -->
    <div id="captain-banner" class="hidden bg-kantar-yellow text-slate-900 p-2.5 rounded-xl shadow-sm text-xs flex items-center justify-between font-medium">
      <div class="flex items-center space-x-2">
        <i class="fa-solid fa-crown text-amber-600 text-sm"></i>
        <span><b>Chế độ Đội trưởng:</b> Quản lý trận đấu, quỹ đội và duyệt chi.</span>
      </div>
    </div>

    <!-- Thanh chuyển Tab -->
    <div class="flex bg-slate-200 p-1 rounded-xl text-xs font-bold shadow-inner">
      <button id="tab-btn-attend" onclick="switchTab('attend')" class="flex-1 py-2 rounded-lg transition bg-white text-kantar-sumo shadow-sm">
        <i class="fa-solid fa-user-check mr-1"></i> Trận đấu
      </button>
      <button id="tab-btn-fund" onclick="switchTab('fund')" class="flex-1 py-2 rounded-lg transition text-slate-500 hover:text-slate-700">
        <i class="fa-solid fa-wallet mr-1"></i> Quỹ Đội
      </button>
      <button id="tab-btn-history" onclick="switchTab('history')" class="flex-1 py-2 rounded-lg transition text-slate-500 hover:text-slate-700">
        <i class="fa-solid fa-clock-rotate-left mr-1"></i> Lịch sử
      </button>
    </div>

    <!-- TAB 1: TRẬN ĐẤU & ĐIỂM DANH -->
    <div id="tab-attend" class="space-y-3">
      <!-- Info Card -->
      <div class="bg-white rounded-2xl p-3.5 shadow-sm border border-slate-200">
        <div class="flex justify-between items-start pb-2 border-b border-slate-100">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-base font-bold text-kantar-sumo flex items-center gap-1.5" id="match-title">Trận 1: Thứ 5 - Sân 7</h2>
              <span id="match-lock-badge" class="hidden text-[10px] bg-red-100 text-red-700 border border-red-200 font-bold px-2 py-0.5 rounded-full flex items-center gap-1">
                <i class="fa-solid fa-lock text-[9px]"></i>Đã khóa DD
              </span>
              <span id="match-processed-badge" class="hidden text-[10px] bg-indigo-100 text-indigo-700 border border-indigo-200 font-bold px-2 py-0.5 rounded-full flex items-center gap-1">
                <i class="fa-solid fa-check-double text-[9px]"></i>Đã Trừ Quỹ
              </span>
            </div>
            <div class="text-[11px] text-slate-500 flex items-center gap-2 mt-0.5">
              <span id="disp-match-time"><i class="fa-regular fa-clock mr-1"></i>19:00 - 20:30</span><span>•</span>
              <span id="disp-match-venue"><i class="fa-solid fa-location-dot mr-1"></i>Sân bóng</span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs text-slate-500">Đã báo đi</span>
            <div class="text-lg font-black text-kantar-blue" id="total-slots">0 suất</div>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-2 pt-2.5 text-center">
          <div class="bg-slate-50 rounded-xl p-2 border border-slate-100">
            <span class="text-[10px] text-slate-500 block">Tiền sân</span>
            <span class="text-xs font-bold text-slate-700" id="disp-pitch-fee">0đ</span>
          </div>
          <div class="bg-slate-50 rounded-xl p-2 border border-slate-100">
            <span class="text-[10px] text-slate-500 block">Nước/bóng</span>
            <span class="text-xs font-bold text-slate-700" id="disp-water-fee">0đ</span>
          </div>
          <div class="bg-teal-50 rounded-xl p-2 border border-teal-100 relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-teal-500 text-white text-[8px] font-bold px-1 rounded-bl">~1k</div>
            <span class="text-[10px] text-teal-600 font-bold block">Chia ra</span>
            <span class="text-xs font-black text-teal-700" id="disp-fee-per-person">0đ</span>
          </div>
        </div>

        <!-- Captain Controls (Match) -->
        <div id="captain-controls" class="hidden mt-3 pt-3 border-t border-dashed border-slate-200 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-amber-700"><i class="fa-solid fa-gear"></i> Setup Trận Đấu</span>
            <button onclick="openEditMatchModal()" class="text-[11px] text-blue-600 hover:underline font-semibold">Sửa thông tin</button>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="text-[10px] font-bold text-slate-500">Tiền sân (VNĐ):</label>
              <input type="number" id="input-pitch" class="w-full text-xs p-2 rounded-lg border border-slate-300 font-semibold disabled:bg-slate-100 disabled:text-slate-400" onchange="updateFees()" />
            </div>
            <div>
              <label class="text-[10px] font-bold text-slate-500">Tiền nước/bóng:</label>
              <input type="number" id="input-water" class="w-full text-xs p-2 rounded-lg border border-slate-300 font-semibold disabled:bg-slate-100 disabled:text-slate-400" onchange="updateFees()" />
            </div>
          </div>
          <div class="flex items-center justify-between bg-slate-50 p-2 rounded-lg border text-xs">
            <span class="text-slate-700 font-medium">🧤 Giảm giá GK:</span>
            <select id="select-gk-discount" onchange="updateGkDiscount(this.value)" class="text-xs p-1 bg-white border rounded font-semibold text-kantar-sumo disabled:bg-slate-100 disabled:text-slate-400">
              <option value="50">Giảm 50%</option><option value="100">Free 100%</option><option value="0">Không giảm</option>
            </select>
          </div>

          <!-- 2 Nút mới: Khóa và Trừ tiền -->
          <div class="grid grid-cols-2 gap-2 pt-1">
            <button id="btn-toggle-lock" onclick="toggleMatchLock()" class="py-2.5 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 text-white shadow-sm">
              <i class="fa-solid fa-lock" id="icon-toggle-lock"></i> <span id="text-toggle-lock">Khóa DD</span>
            </button>
            <button id="btn-process-fund" onclick="processMatchFund()" class="py-2.5 text-xs font-bold rounded-xl transition flex items-center justify-center gap-1.5 text-white shadow-sm">
              <i class="fa-solid fa-money-bill-transfer" id="icon-process-fund"></i> <span id="text-process-fund">Trừ Quỹ</span>
            </button>
          </div>

          <div class="grid grid-cols-2 gap-2 pt-1">
            <button onclick="openShuffleTeamsModal()" class="text-[11px] bg-slate-100 text-slate-700 font-bold py-2 rounded-lg border hover:bg-slate-200 transition">🎲 Chia 2 đội</button>
            <button onclick="openResetModal()" class="text-[11px] bg-slate-100 text-red-600 font-bold py-2 rounded-lg border hover:bg-red-50 transition"><i class="fa-solid fa-rotate-left"></i> Reset trận</button>
          </div>
        </div>
      </div>

      <!-- Khung thêm người -->
      <div class="flex gap-2">
        <input type="text" id="guest-name" placeholder="Thêm bạn ngoài / cầu thủ mới..." class="flex-1 text-xs px-3 py-2 border rounded-xl disabled:bg-slate-100" onkeydown="if(event.key==='Enter') addGuest()" />
        <button id="btn-add-guest" onclick="addGuest()" class="bg-kantar-sumo text-white text-xs font-bold px-3 py-2 rounded-xl disabled:opacity-50"><i class="fa-solid fa-user-plus"></i></button>
      </div>

      <div class="space-y-1.5" id="attendance-list"></div>
    </div>

    <!-- TAB 2: QUỸ ĐỘI -->
    <div id="tab-fund" class="hidden space-y-3">
      <!-- Bảng thông tin CK -->
      <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-sm text-center">
        <h3 class="font-bold text-slate-800 text-sm mb-2">Quét mã nạp Quỹ</h3>
        <div class="flex justify-center mb-2"><img id="qr-image" src="" alt="VietQR" class="w-48 h-auto rounded-xl shadow-sm border" /></div>
        <div class="bg-slate-50 p-2 rounded-xl text-[11px] text-left text-slate-600 space-y-1">
          <div>Ngân hàng: <b id="bank-name">Techcombank</b></div>
          <div class="flex items-center justify-between">
            <div>STK: <b id="bank-acc" class="text-slate-900 text-sm">19037607856011</b></div>
            <button onclick="copyBankAcc()" class="text-xs bg-slate-200 px-2 py-1 rounded font-bold hover:bg-slate-300"><i class="fa-regular fa-copy"></i> Copy</button>
          </div>
          <div>Chủ TK: <b id="bank-owner">BUI VUONG HUNG</b></div>
        </div>
        <div id="captain-bank-edit" class="hidden pt-2 mt-2 border-t">
          <button onclick="openBankModal()" class="text-[11px] text-blue-600 font-bold hover:underline">Sửa tài khoản Ngân hàng nhận</button>
        </div>
      </div>

      <div class="flex justify-between items-center px-1">
        <h3 class="font-bold text-slate-800 text-sm">Số dư anh em</h3>
        <button onclick="generateZaloFundReport()" class="text-xs bg-blue-100 hover:bg-blue-200 text-blue-700 font-bold px-3 py-1.5 rounded-lg flex items-center gap-1 shadow-sm transition">
          <i class="fa-solid fa-share-nodes"></i> Báo Zalo
        </button>
      </div>

      <div class="space-y-2" id="fund-list"></div>
    </div>

    <!-- TAB 3: LỊCH SỬ -->
    <div id="tab-history" class="hidden space-y-2">
      <div class="bg-white rounded-xl p-3 border shadow-sm flex items-center justify-between">
        <div class="text-xs font-bold text-slate-700"><i class="fa-solid fa-list text-kantar-sumo"></i> Lịch sử giao dịch quỹ</div>
        <span class="text-[10px] text-slate-400">100 GD gần nhất</span>
      </div>
      <div class="space-y-1.5" id="logs-list"></div>
    </div>
  </main>

  <!-- MODALS GIAO DIỆN -->
  
  <!-- Modal Nhập PIN -->
  <div id="pin-modal" onclick="if(event.target===this) closePinModal()" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-xs w-full p-5 space-y-4 shadow-xl">
      <div class="text-center space-y-1">
        <div class="w-10 h-10 bg-slate-100 text-kantar-sumo rounded-full flex items-center justify-center mx-auto text-lg font-bold"><i class="fa-solid fa-lock"></i></div>
        <h3 class="font-bold text-slate-800 text-sm">Xác nhận Đội trưởng</h3>
      </div>
      <input type="password" id="input-pin" maxlength="6" placeholder="Nhập mã PIN" class="w-full text-center tracking-widest text-lg font-bold py-2 border rounded-xl focus:outline-none focus:border-kantar-sumo" onkeydown="if(event.key==='Enter') verifyPin()" />
      <div class="flex gap-2">
        <button onclick="closePinModal()" class="flex-1 py-2 text-xs font-semibold bg-slate-100 rounded-xl hover:bg-slate-200">Hủy</button>
        <button onclick="verifyPin()" class="flex-1 py-2 text-xs font-bold text-white bg-kantar-sumo rounded-xl hover:bg-kantar-sumo/90">Xác nhận</button>
      </div>
    </div>
  </div>

  <!-- Modal Đổi Tên Cầu Thủ -->
  <div id="edit-player-modal" onclick="if(event.target===this) closeEditPlayerModal()" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-xs w-full p-4 space-y-3 shadow-xl">
      <div class="text-center"><h3 class="font-bold text-slate-800 text-sm">Đổi tên cầu thủ</h3></div>
      <input type="text" id="edit-player-name-input" class="w-full text-xs p-2 border rounded-lg font-bold focus:outline-none focus:border-kantar-sumo" onkeydown="if(event.key==='Enter') saveEditPlayerModal()" />
      <div class="flex gap-2 pt-1">
        <button onclick="closeEditPlayerModal()" class="flex-1 py-2 text-xs font-semibold bg-slate-100 rounded-xl hover:bg-slate-200">Hủy</button>
        <button onclick="saveEditPlayerModal()" class="flex-1 py-2 text-xs font-bold text-white bg-kantar-sumo rounded-xl hover:bg-kantar-sumo/90">Lưu tên</button>
      </div>
    </div>
  </div>

  <!-- Modal Cập nhật trận đấu -->
  <div id="match-edit-modal" onclick="if(event.target===this) closeEditMatchModal()" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-xs w-full p-5 space-y-3 shadow-xl">
      <div class="text-center space-y-1">
        <h3 class="font-bold text-slate-800 text-sm">Cập nhật trận đấu</h3>
      </div>
      <div>
        <label class="text-[11px] font-medium text-slate-600">Thứ / Tên trận:</label>
        <input type="text" id="edit-match-short" class="w-full text-xs p-2 border rounded-lg font-semibold" placeholder="VD: Thứ 3" />
      </div>
      <div>
        <label class="text-[11px] font-medium text-slate-600">Khung giờ đá:</label>
        <input type="text" id="edit-match-time" class="w-full text-xs p-2 border rounded-lg" placeholder="VD: 19:00 - 20:30" />
      </div>
      <div>
        <label class="text-[11px] font-medium text-slate-600">Sân bóng:</label>
        <input type="text" id="edit-match-venue" class="w-full text-xs p-2 border rounded-lg" placeholder="VD: Sân 7" />
      </div>
      <div class="flex gap-2 pt-1">
        <button onclick="closeEditMatchModal()" class="flex-1 py-2 text-xs font-semibold bg-slate-100 rounded-xl">Hủy</button>
        <button onclick="saveEditMatchModal()" class="flex-1 py-2 text-xs font-bold text-white bg-kantar-sumo rounded-xl">Lưu lại</button>
      </div>
    </div>
  </div>

  <!-- Modal Nạp Quỹ -->
  <div id="add-fund-modal" onclick="if(event.target===this) closeAddFundModal()" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-xs w-full p-5 space-y-3 shadow-xl text-center">
      <h3 class="font-bold text-slate-800 text-sm">Nạp tiền vào Quỹ</h3>
      <p class="text-xs text-kantar-sumo font-bold" id="add-fund-name">...</p>
      <div class="grid grid-cols-3 gap-1.5 py-2">
        <button onclick="document.getElementById('add-fund-amount').value='100000'" class="bg-slate-100 hover:bg-slate-200 text-xs font-bold py-1.5 rounded transition">+100k</button>
        <button onclick="document.getElementById('add-fund-amount').value='200000'" class="bg-slate-100 hover:bg-slate-200 text-xs font-bold py-1.5 rounded transition">+200k</button>
        <button onclick="document.getElementById('add-fund-amount').value='500000'" class="bg-slate-100 hover:bg-slate-200 text-xs font-bold py-1.5 rounded transition">+500k</button>
      </div>
      <input type="number" id="add-fund-amount" placeholder="Hoặc nhập số khác (VD: 300000)" class="w-full text-center text-sm font-bold py-2 border rounded-xl focus:outline-none focus:border-emerald-500" />
      <div class="flex gap-2 pt-2">
        <button onclick="closeAddFundModal()" class="flex-1 py-2 text-xs font-semibold bg-slate-100 hover:bg-slate-200 rounded-xl transition">Hủy</button>
        <button onclick="confirmAddFund()" class="flex-1 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl transition">Nạp ngay</button>
      </div>
    </div>
  </div>

  <!-- Modal Điều chỉnh số dư -->
  <div id="adjust-fund-modal" onclick="if(event.target===this) closeAdjustFundModal()" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-xs w-full p-5 space-y-3 shadow-xl text-center">
      <h3 class="font-bold text-slate-800 text-sm">Điều chỉnh quỹ (Sửa lỗi)</h3>
      <p class="text-[11px] text-slate-500">Chỉ dùng khi cần set lại số dư cho <b id="adjust-fund-name" class="text-slate-800">...</b></p>
      <div class="text-left space-y-2">
        <div>
          <label class="text-[10px] font-bold text-slate-500">Số dư MỚI cần đổi thành:</label>
          <input type="number" id="adjust-fund-amount" class="w-full text-center text-sm font-bold py-2 border rounded-xl focus:outline-none focus:border-amber-500" placeholder="Ví dụ: 0 hoặc 50000" />
        </div>
        <div>
          <label class="text-[10px] font-bold text-slate-500">Lý do điều chỉnh (Bắt buộc):</label>
          <input type="text" id="adjust-fund-reason" class="w-full text-xs py-2 px-3 border rounded-xl focus:outline-none focus:border-amber-500" placeholder="VD: Tính nhầm tiền sân tuần trước..." />
        </div>
      </div>
      <div class="flex gap-2 pt-2">
        <button onclick="closeAdjustFundModal()" class="flex-1 py-2 text-xs font-semibold bg-slate-100 hover:bg-slate-200 rounded-xl transition">Hủy</button>
        <button onclick="confirmAdjustFund()" class="flex-1 py-2 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 rounded-xl transition">Lưu số mới</button>
      </div>
    </div>
  </div>

  <!-- Modal Cấu hình Ngân hàng -->
  <div id="bank-modal" onclick="if(event.target===this) closeBankModal()" class="fixed inset-0 bg-black/60 z-50 hidden flex items-center justify-center p-4">
